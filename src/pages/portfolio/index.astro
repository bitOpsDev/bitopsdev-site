---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('portfolio')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<BaseHead title={`Portfolio | ${SITE_TITLE}`} description="Unity Assets, Tutorials, Blender work & more" />
	</head>
	<body>
		<Header />

		<main>
			<section class="page-header">
				<h1>Portfolio</h1>
				<p class="subtitle">Unity Assets • Tutorials • Blender Models • Tools</p>
			</section>

			<!-- Sub Navigation + Search -->
			<div class="subnav">
				<div class="filters">
					<button class="filter-btn active" data-filter="All">All</button>
					<button class="filter-btn" data-filter="Unity Asset">Unity Assets</button>
					<button class="filter-btn" data-filter="Tutorial">Tutorials</button>
					<button class="filter-btn" data-filter="Blender">Blender</button>
					<button class="filter-btn" data-filter="Tool">Tools</button>
				</div>
				<input type="text" id="portfolio-search" placeholder="Search portfolio..." class="search-input">
			</div>

			<section>
				<ul class="portfolio-grid">
					{
						posts.map((post) => (
							<li class="portfolio-item" 
								data-tags={(post.data.tags || []).join(' ').toLowerCase()}
								data-title={post.data.title.toLowerCase()}>
								<a href={`/portfolio/${post.id}/`}>
									{post.data.heroImage && (
										<img
											src={post.data.heroImage}
											alt={post.data.title}
											class="portfolio-hero"
										/>
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
  main {
    width: 960px;
    max-width: calc(100% - 2em);
    margin: auto;
  }

  .page-header {
    text-align: center;
    padding: 4rem 1rem 2rem;
  }

  .subtitle {
    font-size: 1.4rem;
    color: rgb(var(--gray));
  }

  .subnav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: rgb(var(--gray-light));
    border-radius: 12px;
    margin-bottom: 2rem;
  }

  [data-theme="dark"] .subnav {
    background: #161b22;
  }

  .filters button {
    padding: 0.6rem 1.2rem;
    background: transparent;
    border: 1px solid rgb(var(--gray));
    color: rgb(var(--gray-dark));
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s;
  }

  [data-theme="dark"] .filters button {
    color: #c9d1d9;
    border-color: #30363d;
  }

  .filters button.active,
  .filters button:hover {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  .search-input {
    padding: 0.7rem 1rem;
    background: rgb(var(--gray-light));
    border: 1px solid rgb(var(--gray));
    border-radius: 9999px;
    color: rgb(var(--gray-dark));
    width: 280px;
  }

  [data-theme="dark"] .search-input {
    background: #0d1117;
    border-color: #30363d;
    color: white;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  .portfolio-hero {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .portfolio-item .title {
    padding: 1.2rem 1.5rem 0.5rem;
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.3;
  }

  .portfolio-item .date {
    padding: 0 1.5rem 1.2rem;
    margin: 0;
    color: rgb(var(--gray));
    font-size: 0.95rem;
  }
</style>

<script>
  let currentFilter = 'All';
  let searchTerm = '';

  function filterItems() {
    const items = document.querySelectorAll('.portfolio-item');
    items.forEach(item => {
      const el = item as HTMLElement;
      const tags = el.dataset.tags || '';
      const title = el.dataset.title || '';

      const matchesFilter = currentFilter === 'All' || tags.includes(currentFilter.toLowerCase());
      const matchesSearch = title.includes(searchTerm.toLowerCase());

      el.style.display = (matchesFilter && matchesSearch) ? 'block' : 'none';
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.dataset.filter || 'All';
        filterItems();
      });
    });

    const searchInput = document.getElementById('portfolio-search') as HTMLInputElement;
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchTerm = (e.target as HTMLInputElement).value;
        filterItems();
      });
    }
  });
</script>