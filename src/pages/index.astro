---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<!-- Full Width Banner Hero -->
			<section class="hero-banner">
				<img src="/Banner.jpg" alt="Sci-fi corridor from the current multiplayer horror game" class="banner-image" />
				<div class="hero-overlay">
					<h1>Building a co-op horror game in Unity</h1>
					<p class="tagline">Solo developer shipping multiplayer games, assets, and the real build journey.</p>
					<div class="hero-buttons">
						<a href="/games" class="btn-primary">See the project</a>
					</div>
				</div>
			</section>

			<!-- Welcome / YouTube -->
			<section class="section follow-section">
				<h2 class="text-center">Welcome to bitOps Dev</h2>
				<p class="intro-copy">
					Tutorials, assets, and progress videos on Unity, Blender, and game development.
				</p>
				<div class="youtube-embed">
					<iframe
						width="560"
						height="315"
						src="https://www.youtube.com/embed/0R2kAlBcMsk"
						title="Rebranding My YouTube Channel | Info Gamer to bitOps Dev"
						frameborder="0"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
					></iframe>
				</div>
				<div class="hero-buttons">
					<a href="https://www.youtube.com/@bitOpsDev/videos" target="_blank" class="btn-primary">Subscribe on YouTube</a>
				</div>
			</section>

			<!-- Spotlight: Snowball -->
			<section class="spotlight-section">
				<div class="spotlight-card">
					<a href="/games/snowball/" class="spotlight-image-link" aria-label="Read about Snowball">
						<img
							src="/images/games/snowball-hero.jpg"
							alt="A snowball rolling through the town in Snowball, a free multiplayer io game in development"
							loading="lazy"
						/>
					</a>
					<div class="spotlight-copy">
						<p class="spotlight-label">New project</p>
						<h2>Snowball</h2>
						<p>
							A free multiplayer io-style game where you roll a snowball around a winter world, grow as you go, and try to be the last ball standing. It's in development, and I'm building it with AI help as an experiment.
						</p>
						<div class="spotlight-buttons">
							<a href="/games/snowball/" class="btn-primary">Read about Snowball</a>
							<a href="https://youtu.be/iVdmObATbN8" target="_blank" rel="noopener" class="btn-secondary">Watch the video</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Featured Work - Visual Cards -->
			<section class="featured-section">
				<h2 class="text-center mb-12">Featured Work</h2>
				<div class="featured-grid">
					<a href="/games" class="featured-card games-card">
						<h3>Games</h3>
					</a>

					<a href="/portfolio" class="featured-card portfolio-card">
						<h3>Portfolio</h3>
					</a>

					<a href="/blog" class="featured-card journal-card">
						<h3>Journal</h3>
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
  .hero-banner {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: 65vh;
    min-height: 480px;
    max-height: 700px;
    overflow: hidden;
  }

  .banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(13,17,23,0.25), rgba(13,17,23,0.8));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1.5rem;
    color: white;
    z-index: 2;
  }

  .hero-overlay h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin-bottom: 1rem;
    color: white !important;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.85);
  }

  .tagline {
    font-size: 1.45rem;
    max-width: 700px;
    margin-bottom: 2.5rem;
    color: white !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
  }

  .follow-section {
    padding-top: 3.5rem;
  }

  .intro-copy {
    max-width: 640px;
    margin: 0 auto 1.75rem;
    text-align: center;
    line-height: 1.6;
  }

  .hero-buttons {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary, .btn-secondary {
    padding: 1rem 2.2rem;
    font-size: 1.15rem;
    border-radius: 9999px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }

  .btn-primary {
    background: #00e5ff;
    color: #0d1117;
  }

  .btn-primary:hover {
    background: #00f0ff;
    transform: translateY(-4px);
  }

  .btn-secondary {
    border: 2px solid #00e5ff;
    color: #00e5ff;
  }

  .btn-secondary:hover {
    background: rgba(0, 229, 255, 0.1);
  }

  .spotlight-section {
    padding: 3rem 1rem 1rem;
  }

  .spotlight-card {
    display: flex;
    flex-direction: column;
    max-width: 1100px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid rgba(0, 229, 255, 0.25);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .spotlight-image-link {
    display: block;
    overflow: hidden;
  }

  .spotlight-image-link img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 12 / 5;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .spotlight-image-link:hover img {
    transform: scale(1.03);
  }

  .spotlight-copy {
    padding: 1.25rem 1.5rem 1.5rem;
    text-align: center;
  }

  .spotlight-label {
    margin: 0 0 0.25rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #00e5ff;
  }

  .spotlight-copy h2 {
    margin: 0 0 0.5rem;
    font-size: 2.2rem;
  }

  .spotlight-copy p {
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .spotlight-copy .spotlight-label {
    max-width: none;
  }

  .spotlight-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1.25rem;
  }

  .featured-section {
    padding: 5rem 1rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .featured-card {
    height: 320px;
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: end;
    justify-content: center;
    text-align: center;
    color: white;
    text-decoration: none;
    transition: all 0.4s ease;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .featured-card:hover {
    transform: scale(1.04);
    box-shadow: 0 20px 40px rgba(0, 229, 255, 0.2);
  }

  .featured-card h3 {
    font-size: 2rem;
    font-weight: 700;
    z-index: 2;
    padding: 1.5rem;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.8);
  }

  .games-card {
    background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('/games-bg.jpg');
    background-size: cover;
    background-position: center;
  }

  .portfolio-card {
    background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('/portfolio-bg.jpg');
    background-size: cover;
    background-position: center;
  }

  .journal-card {
    background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('/journal-bg.jpg');
    background-size: cover;
    background-position: center;
  }

  .text-center {
    text-align: center;
  }

  @media (max-width: 720px) {
    .spotlight-image-link img {
      aspect-ratio: 16 / 9;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .featured-card {
      height: 240px;
    }
  }
</style>
