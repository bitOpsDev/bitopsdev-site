---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<!-- Full Width Banner Hero -->
			

			<!-- Current Focus -->
			<section class="section">
				<h2 class="text-center">Welcome to bitOps Dev</h2>
				<div class="youtube-embed">
    <iframe width="560" height="315" src="https://www.youtube.com/embed/0R2kAlBcMsk?si=463bJOWKjqXZPLct" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
</div>
<div class="hero-buttons">
            <a href="https://www.youtube.com/@bitOpsDev/videos" target="_blank" class="btn-primary">Subscribe on YouTube</a>
        </div>
				<p>
            Solo Unity developer building multiplayer games, professional assets, 
            and sharing the real development journey.
        </p>
        <p>
            Watch my YouTube tutorials on Unity, Blender, and game development. 
            Download free code and assets, and follow along as I build my next big project.
        </p>
		
		
			</section>
			<br>

			<!-- Full Width Banner Hero -->
			<section class="hero-banner">
				<img src="/Banner.jpg" alt="BitOpsDev Banner" class="banner-image" />
				<div class="hero-overlay">
					<h1>Current Project</h1>
					<p class="tagline">I'm actively working on a new multiplayer game built in Unity.</p>
					
					<div class="hero-buttons">
						<a href="/games" class="btn-primary">CHECK IT OUT</a>
					</div>
				</div>
			</section>

						<!-- Featured Work - Visual Cards -->
			<section class="featured-section">
				<h2 class="text-center mb-12">Featured Work</h2>
				<div class="featured-grid">
					
					<!-- Games Card -->
					<a href="/games" class="featured-card games-card">
						<h3>Games</h3>
					</a>
					
					<!-- Portfolio Card -->
					<a href="/portfolio" class="featured-card portfolio-card">
						<h3>Portfolio</h3>
					</a>
					
					<!-- Journal Card -->
					<a href="/blog" class="featured-card journal-card">
						<h3>Journal</h3>
					</a>
					
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
    .hero-banner {
    position: relative;
    width: 100vw;                    /* Full viewport width */
    margin-left: calc(50% - 50vw);   /* Full bleed trick */
    height: 65vh;
    min-height: 480px;
    max-height: 700px;
    overflow: hidden;
  }

  .banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;               /* Keeps full image visible */
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(13,17,23,0.25), rgba(13,17,23,0.8));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1.5rem;
    color: white;                    /* Force white */
    z-index: 2;
  }

  .hero-overlay h1 {
    font-size: 3.6rem;
    margin-bottom: 1rem;
    color: white !important;         /* Force white even in light mode */
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.85);
  }

  .tagline {
    font-size: 1.45rem;
    max-width: 700px;
    margin-bottom: 2.5rem;
    color: white !important;         /* Force white */
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
  }

  .hero-buttons {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary, .btn-secondary {
    padding: 1rem 2.2rem;
    font-size: 1.15rem;
    border-radius: 9999px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }

  .btn-primary {
    background: #00e5ff;
    color: #0d1117;
  }

  .btn-primary:hover {
    background: #00f0ff;
    transform: translateY(-4px);
  }

  .btn-secondary {
    border: 2px solid #00e5ff;
    color: #00e5ff;
  }

  .btn-secondary:hover {
    background: rgba(0, 229, 255, 0.1);
  }

    .featured-section {
    padding: 5rem 1rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .featured-card {
    height: 320px;
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: end;
    justify-content: center;
    text-align: center;
    color: white;
    text-decoration: none;
    transition: all 0.4s ease;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .featured-card:hover {
    transform: scale(1.04);
    box-shadow: 0 20px 40px rgba(0, 229, 255, 0.2);
  }

  .featured-card h3 {
    font-size: 2rem;
    font-weight: 700;
    z-index: 2;
    padding: 1.5rem;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.8);
  }

  /* Background Images */
  .games-card {
    background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('/games-bg.jpg');
    background-size: cover;
    background-position: center;
  }

  .portfolio-card {
    background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('/portfolio-bg.jpg');
    background-size: cover;
    background-position: center;
  }

  .journal-card {
    background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('/journal-bg.jpg');
    background-size: cover;
    background-position: center;
  }
  .text-center {
    text-align: center;
}
.youtube-embed {
    max-width: 960px;
    margin: 3rem auto;
    padding: 0 1rem;
    text-align: center;
}

.youtube-embed iframe {
    width: 100%;
    max-width: 100%;
    height: 400px;           /* Good default for 16:9 */
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    border: none;
}

/* Responsive adjustment */
@media (max-width: 720px) {
    .youtube-embed iframe {
        height: 340px;
    }
}

</style>