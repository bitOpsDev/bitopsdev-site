---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="Solo Unity developer with over 10 years of experience" />
	</head>
	<body>
		<Header />

		<main>
			<section class="about-hero">
				<img src="/about-hero.jpg" alt="Nathan - BitOpsDev" class="hero-image" />
			</section>

			<section class="about-content">
				<h1>About Me</h1>
				
				<p>
					Hi, I'm Nathan — the one-person team behind <strong>BitOpsDev</strong>.
				</p>
				
				<p>
					For over <strong>10 years</strong>, I've been creating Unity tutorials, assets, and games on YouTube. 
					What started as <strong>Info Gamer Hub</strong> has now evolved into BitOpsDev — a more focused 
					brand where I build real games, professional assets, and share the complete development journey 
					with the community.
				</p>

				<p>
					I've released multiple mobile games over the years, but my current focus is on a larger-scale 
					<strong>multiplayer game</strong> planned for Steam. Alongside game development, I continue creating 
					in-depth Unity tutorials, Blender content, and techniques other developers can use.
				</p>

				<p>
					My goal is simple: build cool things, learn in public, and help others do the same. Whether you're 
					a beginner trying to make your first game or an experienced dev looking for useful assets and techniques, 
					you'll find valuable content here.
				</p>

				<h2>What's Next?</h2>
				<p>
					I plan to keep creating content for many years to come — more tutorials, more assets, more dev logs, 
					and bigger game releases. If you're on this journey with me, thank you. Let's build something great together.
				</p>

				<div class="about-cta">
					<a href="https://www.youtube.com/@bitOpsDev" target="_blank" class="btn-primary">
						Watch on YouTube
					</a>
					<a href="/portfolio" class="btn-secondary">
						View My Portfolio
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
  .about-hero {
    height: 420px;
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-content {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1rem;
    line-height: 1.7;
  }

  .about-content h1 {
    font-size: 3rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .about-content h2 {
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .about-cta {
    margin-top: 3rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
