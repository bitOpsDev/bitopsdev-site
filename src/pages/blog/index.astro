---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Journal | ${SITE_TITLE}`} description="Dev logs and behind-the-scenes updates" />
	</head>
	<body>
		<Header />

		<main>
			<section class="journal-header">
				<h1>Journal</h1>
				<p class="subtitle">Dev logs, lessons learned, and behind-the-scenes from development</p>
			</section>

			<section class="journal-list">
				{
					posts.map((post) => (
						<a href={`/blog/${post.id}`} class="journal-entry">
							<div class="entry-image">
								{post.data.heroImage && (
									<img
										src={post.data.heroImage.src}
										alt={post.data.title}
									/>
								)}
							</div>
							<div class="entry-content">
								<div class="entry-meta">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h2 class="entry-title">{post.data.title}</h2>
								<p class="entry-description">{post.data.description}</p>
							</div>
						</a>
					))
				}
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
  main {
    width: 960px;
    max-width: calc(100% - 2em);
    margin: auto;
  }

  .journal-header {
    text-align: center;
    padding: 4rem 1rem 3rem;
  }

  .journal-header h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1.4rem;
    color: rgb(var(--gray));
  }

  .journal-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1rem;
  }

  .journal-entry {
    display: flex;
    gap: 2rem;
    background: rgb(var(--gray-light));
    border: 1px solid rgb(var(--gray));
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.3s ease;
    padding: 1rem;
  }

  [data-theme="dark"] .journal-entry {
    background: #161b22;
    border-color: #30363d;
  }

  .journal-entry:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  .entry-image {
    flex-shrink: 0;
    width: 380px;
    border-radius: 12px;
    overflow: hidden;
  }

  .entry-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .entry-content {
    flex: 1;
    padding: 1rem 1rem 1rem 0;
    display: flex;
    flex-direction: column;
  }

  .entry-meta {
    color: rgb(var(--gray));
    font-size: 0.95rem;
    margin-bottom: 0.8rem;
  }

  .entry-title {
    margin: 0 0 0.8rem 0;
    font-size: 1.75rem;
    line-height: 1.3;
    color: rgb(var(--black));
  }

  [data-theme="dark"] .entry-title {
    color: white;
  }

  .entry-description {
    color: rgb(var(--gray));
    line-height: 1.6;
    margin-top: auto;
  }

  @media (max-width: 720px) {
    .journal-entry {
      flex-direction: column;
    }
    .entry-image {
      width: 100%;
      height: 220px;
    }
  }
</style>