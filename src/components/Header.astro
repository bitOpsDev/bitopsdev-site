---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<script is:inline>
  const saved = localStorage.getItem('theme');
  document.documentElement.setAttribute('data-theme', saved || 'dark');
</script>

<header>
  <nav aria-label="Primary">
    <h2>
      <a href="/">
        <img src="/logo.png" alt="bitOps Dev Logo" width="64" height="64" />
        <span>{SITE_TITLE}</span>
      </a>
    </h2>

    <div class="internal-links" id="site-nav">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/games">Games</HeaderLink>
      <HeaderLink href="/portfolio">Portfolio</HeaderLink>
      <HeaderLink href="/blog">Journal</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>

      <div class="mobile-socials">
        <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer">
          <span class="sr-only">YouTube</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="currentColor">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.7 15.5V8.5l6.3 3.5-6.3 3.5z"/>
          </svg>
        </a>
        <a href={SOCIAL_LINKS.tiktok} target="_blank" rel="noopener noreferrer">
          <span class="sr-only">TikTok</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="nav-actions">
      <button id="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark mode">
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>

      <div class="social-links">
        <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer">
          <span class="sr-only">YouTube</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="26" height="26" fill="currentColor">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.7 15.5V8.5l6.3 3.5-6.3 3.5z"/>
          </svg>
        </a>

        <a href={SOCIAL_LINKS.tiktok} target="_blank" rel="noopener noreferrer">
          <span class="sr-only">TikTok</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="26" height="26" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/>
          </svg>
        </a>
      </div>

      <button
        id="nav-toggle"
        class="nav-toggle"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </nav>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const iconMoon = document.getElementById('icon-moon');
  const iconSun = document.getElementById('icon-sun');
  const navToggle = document.getElementById('nav-toggle');
  const siteNav = document.getElementById('site-nav');
  const header = document.querySelector('header');

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    if (theme === 'dark') {
      iconMoon!.style.display = 'none';
      iconSun!.style.display = 'block';
    } else {
      iconMoon!.style.display = 'block';
      iconSun!.style.display = 'none';
    }
  }

  function setNavOpen(open: boolean) {
    header?.classList.toggle('nav-open', open);
    navToggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
    navToggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.classList.toggle('nav-lock', open);
  }

  const current = localStorage.getItem('theme') || 'dark';
  applyTheme(current);

  themeToggle?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    applyTheme(next);
  });

  navToggle?.addEventListener('click', () => {
    const open = navToggle.getAttribute('aria-expanded') !== 'true';
    setNavOpen(open);
  });

  siteNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setNavOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setNavOpen(false);
  });

  window.matchMedia('(min-width: 821px)').addEventListener('change', (event) => {
    if (event.matches) setNavOpen(false);
  });
</script>

<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    transition: background 0.2s ease;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  :global([data-theme="dark"]) header {
    background: #0d1117;
    box-shadow: 0 1px 0 rgb(var(--gray-light));
  }

  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a {
    display: flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
  }

  h2 a img {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    flex-shrink: 0;
  }

  h2 a span {
    line-height: 1;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 72px;
  }

  nav a {
    padding: 1em 0.5em;
    color: var(--black);
    border-bottom: 4px solid transparent;
    text-decoration: none;
  }

  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }

  .internal-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.15rem;
  }

  .mobile-socials {
    display: none;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: auto;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.1em;
  }

  .social-links a,
  .mobile-socials a {
    display: flex;
    align-items: center;
    padding: 0.4em;
    border-radius: 6px;
    transition: background 0.15s ease, color 0.15s ease;
    color: inherit;
    border-bottom: none;
  }

  .social-links a:hover,
  .mobile-socials a:hover {
    background: rgba(128, 128, 128, 0.15);
  }

  #theme-toggle,
  .nav-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    padding: 0.4em;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: background 0.15s ease;
  }

  #theme-toggle:hover,
  .nav-toggle:hover {
    background: rgba(128, 128, 128, 0.15);
  }

  #icon-sun  { display: none; }
  #icon-moon { display: block; }

  .nav-toggle {
    display: none;
    width: 42px;
    height: 42px;
    flex-direction: column;
    gap: 5px;
  }

  .nav-toggle-bar {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  header.nav-open .nav-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  header.nav-open .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }

  header.nav-open .nav-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  :global(body.nav-lock) {
    overflow: hidden;
  }

  @media (max-width: 820px) {
    h2 a img {
      width: 48px;
      height: 48px;
    }

    .social-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .internal-links {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.75rem 1rem 1.25rem;
      background: white;
      border-bottom: 1px solid rgba(var(--gray), 25%);
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.18);
    }

    :global([data-theme="dark"]) .internal-links {
      background: #0d1117;
      border-bottom-color: #30363d;
      box-shadow: 0 18px 36px rgba(0, 0, 0, 0.45);
    }

    header.nav-open .internal-links {
      display: flex;
    }

    .internal-links a {
      padding: 0.9rem 0.35rem;
      border-bottom: 1px solid rgba(128, 128, 128, 0.18);
    }

    .internal-links a.active {
      border-bottom-color: var(--accent);
      color: var(--accent);
    }

    .mobile-socials {
      display: flex;
      gap: 0.75rem;
      padding-top: 1rem;
    }
  }
</style>
