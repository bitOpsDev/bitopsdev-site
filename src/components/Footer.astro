---
import YouTubeFacade from './YouTubeFacade.astro';
import { SOCIAL_LINKS } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-content">
		<p>
			&copy; {today.getFullYear()} BitOpsDev • Nathan. All rights reserved.
		</p>

		<div class="social-links">
			<a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
				<span class="sr-only">YouTube</span>
				<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
					<path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.7 15.5V8.5l6.3 3.5-6.3 3.5z"/>
				</svg>
			</a>
			<a href={SOCIAL_LINKS.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
				<span class="sr-only">TikTok</span>
				<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
					<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/>
				</svg>
			</a>
		</div>
	</div>
</footer>

<YouTubeFacade />

<style>
	footer {
		padding: 3rem 1rem 2rem;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray));
		text-align: center;
		border-top: 1px solid rgb(var(--gray));
	}

	[data-theme="dark"] footer {
		background: #0d1117;
		border-top-color: #30363d;
		color: #8b949e;
	}

	.footer-content {
		max-width: 960px;
		margin: 0 auto;
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.social-links a {
		color: rgb(var(--gray));
		transition: color 0.2s;
	}

	.social-links a:hover {
		color: var(--accent);
	}

	.social-links svg {
		width: 24px;
		height: 24px;
	}
</style>
