---
// Upgrades .youtube-embed iframes into click-to-play facades (thumbnail + play).
// Fixes the black 0:00 player on first paint and only loads YouTube after a user click.
---

<script is:inline>
	(function () {
		function parseYouTube(src) {
			try {
				var url = new URL(src, 'https://www.youtube.com');
				var videoId = null;
				var listId = url.searchParams.get('list');
				var match = url.pathname.match(/\/embed\/([a-zA-Z0-9_-]{11})/);
				if (match) videoId = match[1];
				if (url.pathname.indexOf('videoseries') !== -1) videoId = null;
				return { videoId: videoId, listId: listId };
			} catch (e) {
				return null;
			}
		}

		function embedUrl(info, autoplay) {
			var params = new URLSearchParams();
			if (autoplay) params.set('autoplay', '1');
			params.set('rel', '0');
			params.set('playsinline', '1');
			if (info.listId) params.set('list', info.listId);
			if (info.videoId) {
				return 'https://www.youtube-nocookie.com/embed/' + info.videoId + '?' + params.toString();
			}
			if (info.listId) {
				return 'https://www.youtube-nocookie.com/embed/videoseries?' + params.toString();
			}
			return null;
		}

		function makeIframe(src, title) {
			var iframe = document.createElement('iframe');
			iframe.src = src;
			iframe.title = title || 'YouTube video';
			iframe.allow =
				'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
			iframe.allowFullscreen = true;
			iframe.referrerPolicy = 'strict-origin-when-cross-origin';
			return iframe;
		}

		function activate(container, info, title) {
			var src = embedUrl(info, true);
			if (!src) return;
			container.innerHTML = '';
			container.appendChild(makeIframe(src, title));
		}

		function upgrade(iframe) {
			if (iframe.dataset.ytUpgraded === '1') return;
			var src = iframe.getAttribute('src');
			if (!src) return;
			var info = parseYouTube(src);
			if (!info || (!info.videoId && !info.listId)) return;
			iframe.dataset.ytUpgraded = '1';

			var title = iframe.getAttribute('title') || 'Play YouTube video';
			var container = iframe.closest('.youtube-embed');
			if (!container) return;

			// Playlists: clean embed URL, keep iframe (no single-video thumbnail).
			if (!info.videoId && info.listId) {
				iframe.src = embedUrl(info, false);
				iframe.setAttribute('loading', 'lazy');
				return;
			}

			var button = document.createElement('button');
			button.type = 'button';
			button.className = 'yt-facade';
			button.setAttribute('aria-label', title);

			var img = document.createElement('img');
			img.src = 'https://i.ytimg.com/vi/' + info.videoId + '/hqdefault.jpg';
			img.alt = '';
			img.loading = 'lazy';
			img.decoding = 'async';

			var play = document.createElement('span');
			play.className = 'yt-facade-play';
			play.setAttribute('aria-hidden', 'true');

			button.appendChild(img);
			button.appendChild(play);
			button.addEventListener('click', function () {
				activate(container, info, title);
			});

			container.innerHTML = '';
			container.appendChild(button);
		}

		function run() {
			document
				.querySelectorAll('.youtube-embed iframe[src*="youtube"]')
				.forEach(upgrade);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', run);
		} else {
			run();
		}
	})();
</script>
